{
  "name": "TipoPonto",
  "type": "object",
  "properties": {
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do tipo de ponto (ex: Pole Position, Volta Mais R\u00e1pida Geral)"
    },
    "valor": {
