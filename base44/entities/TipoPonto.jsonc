      "description": "Valor do ponto (positivo ou negativo, aceita decimais como 0.25)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o tipo de ponto est\u00e1 ativo"
    }
  },
  "required": [
