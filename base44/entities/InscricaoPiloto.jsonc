{
  "name": "InscricaoPiloto",
  "type": "object",
  "properties": {
    "campeonato_id": {
      "type": "string",
      "description": "ID do campeonato"
    },
    "piloto_nome": {
      "type": "string",
      "description": "Nome do piloto"
    },
    "numero_kart": {
      "type": "string",
      "description": "N\u00famero do kart do piloto neste campeonato"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria principal do piloto (legado)"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Categorias do piloto neste campeonato (pode correr em mais de uma)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a inscri\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "campeonato_id",
    "piloto_nome"
  ]
}