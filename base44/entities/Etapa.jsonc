{
  "name": "Etapa",
  "type": "object",
  "properties": {
    "campeonato_id": {
      "type": "string",
      "description": "ID do campeonato ao qual esta etapa pertence"
    },
    "ano": {
      "type": "number",
      "description": "Ano da temporada"
    },
    "mes": {
      "type": "number",
      "description": "M\u00eas da etapa"
    },
    "numero_etapa": {
      "type": "number",
      "description": "N\u00famero da etapa (1\u00aa, 2\u00aa, etc.)"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da etapa"
    },
    "local": {
      "type": "string",
      "description": "Local da etapa"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria vinculada \u00e0 etapa (para campeonatos com categorias)"
    },
    "finalizada": {
      "type": "boolean",
      "default": false,
      "description": "Se a etapa foi finalizada (edicao de resultados travada)"
    },
    "publicado": {
      "type": "boolean",
      "default": false,
      "description": "Se a etapa est\u00e1 publicada (vis\u00edvel no painel p\u00fablico Acompanhe). Rascunho (false) oculta resultados do p\u00fablico at\u00e9 revis\u00e3o."
    },
    "dobrar_pontos": {
      "type": "boolean",
      "default": false,
      "description": "Se os pontos da etapa s\u00e3o dobrados"
    }
  },
  "required": [
    "ano",
    "numero_etapa",
    "data_hora"
  ]
}